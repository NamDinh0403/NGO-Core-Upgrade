{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ingest/schemas/release-manifest-v2.schema.json",
  "title": "Release Manifest (Schema v2)",
  "description": "Root coordination manifest for partitioned release knowledge artifacts.",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "lifecycle",
    "identity",
    "summary",
    "partitions",
    "manifestHash"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "lifecycle": {
      "type": "object",
      "required": ["status", "generatedAt"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["GENERATED", "VALIDATED", "REVIEWED", "PUBLISHED"]
        },
        "generatedAt": { "type": "string" },
        "validatedAt": { "type": ["string", "null"] },
        "reviewedAt": { "type": ["string", "null"] },
        "publishedAt": { "type": ["string", "null"] },
        "reviewedBy": { "type": ["string", "null"] }
      }
    },
    "identity": {
      "type": "object",
      "required": ["analyzerVersion", "version", "fromCommit", "toCommit", "key"],
      "properties": {
        "analyzerVersion": { "type": "string" },
        "version": { "type": "string" },
        "fromCommit": { "type": "string" },
        "toCommit": { "type": "string" },
        "notesHash": { "type": ["string", "null"] },
        "key": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["totalFilesChanged", "highSignalChangeCount"],
      "properties": {
        "totalFilesChanged": { "type": "integer" },
        "highSignalChangeCount": { "type": "integer" },
        "unresolvedAmbiguities": { "type": "integer" }
      }
    },
    "partitions": {
      "type": "object",
      "required": ["evidence", "backend", "frontend", "shared"],
      "properties": {
        "evidence": {
          "type": "object",
          "required": ["path", "size", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "size": { "type": "integer" },
            "sha256": { "type": "string" },
            "recordCount": { "type": "integer" }
          }
        },
        "backend": {
          "type": "object",
          "required": ["path", "size", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "size": { "type": "integer" },
            "sha256": { "type": "string" },
            "recordCount": { "type": "integer" }
          }
        },
        "frontend": {
          "type": "object",
          "required": ["path", "size", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "size": { "type": "integer" },
            "sha256": { "type": "string" },
            "recordCount": { "type": "integer" }
          }
        },
        "shared": {
          "type": "object",
          "required": ["path", "size", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "size": { "type": "integer" },
            "sha256": { "type": "string" },
            "recordCount": { "type": "integer" }
          }
        },
        "database": {
          "type": "object",
          "required": ["path", "size", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "size": { "type": "integer" },
            "sha256": { "type": "string" },
            "recordCount": { "type": "integer" }
          }
        },
        "releaseNotes": {
          "type": "object",
          "required": ["path", "size", "sha256"],
          "properties": {
            "path": { "type": "string" },
            "size": { "type": "integer" },
            "sha256": { "type": "string" }
          }
        }
      }
    },
    "manifestHash": { "type": "string" }
  },
  "additionalProperties": false
}
