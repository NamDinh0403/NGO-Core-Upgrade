{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ingest/schemas/core-change-set.schema.json",
  "title": "Canonical CoreChangeSet",
  "type": "object",
  "required": ["schemaVersion", "status", "source", "releases", "fingerprint"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "CANDIDATE" },
    "source": {
      "type": "object",
      "required": ["corePath", "fromVersion", "toVersion", "fromRevision", "toRevision"],
      "additionalProperties": false,
      "properties": {
        "corePath": { "type": "string" }, "releaseNotesPath": { "type": ["string", "null"] },
        "fromVersion": { "type": "string" }, "toVersion": { "type": "string" },
        "fromRevision": { "type": ["string", "null"] }, "toRevision": { "type": ["string", "null"] }
      }
    },
    "releases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["version", "evidence", "identity", "recordHash"], "additionalProperties": false,
        "properties": {
          "version": { "type": "string" }, "evidence": { "type": "string" }, "recordHash": { "type": "string" },
          "identity": { "anyOf": [{ "type": "null" }, { "$ref": "ingested-release.schema.json#/properties/identity" }] }
        }
      }
    },
    "shared": { "type": "array", "items": { "type": "object" } },
    "backend": { "type": "array", "items": { "type": "object" } },
    "frontend": { "type": "array", "items": { "type": "object" } },
    "fingerprint": { "type": "string" }
  }
}