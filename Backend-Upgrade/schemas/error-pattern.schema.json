{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/error-pattern.schema.json",
  "title": "Error Pattern",
  "description": "Structured signature for recognizing a compiler/runtime error family. Complements fix-pattern.",
  "type": "object",
  "required": ["schemaVersion", "patternId", "status", "errorCode", "signature", "createdAt"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "patternId": { "type": "string" },
    "status": { "type": "string", "enum": ["candidate","under-review","approved","deprecated","rejected","superseded"] },
    "errorCode": { "type": "string" },
    "signature": { "type": "string", "description": "regex or textual signature of the error message" },
    "classifyAs": { "type": ["string","null"] },
    "commonCauses": { "type": "array", "items": { "type": "string" } },
    "linkedFixPatternIds": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
