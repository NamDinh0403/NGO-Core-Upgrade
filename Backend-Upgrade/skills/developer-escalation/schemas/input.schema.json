{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skills/developer-escalation/schemas/input.schema.json",
  "title": "developer-escalation input",
  "type": "object",
  "required": ["skillId", "runDir", "phase", "currentSkill", "checkpointRef", "blocker"],
  "properties": {
    "skillId": { "type": "string", "const": "developer-escalation" },
    "runDir": { "type": "string" },
    "phase": { "type": "string" },
    "currentSkill": { "type": "string" },
    "checkpointRef": { "type": "string" },
    "blocker": { "type": "string" },
    "uncertaintyIds": { "type": "array", "items": { "type": "string" } },
    "attemptedFixes": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": true
}
