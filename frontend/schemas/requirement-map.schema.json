{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/requirement-map.schema.json",
  "title": "Requirement-to-client mapping entry",
  "type": "object",
  "required": ["requirementId", "disposition", "plannedAction", "risk"],
  "properties": {
    "requirementId": { "type": "string" },
    "appliesToClient": { "type": "boolean" },
    "implementationCandidates": { "type": "array", "items": { "type": "string" } },
    "effectiveImplementationPoint": { "type": ["string", "null"] },
    "candidateConfidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
    "supportingEvidence": { "type": "array", "items": { "type": "string" } },
    "disposition": {
      "enum": [
        "SATISFIED_DIRECTLY", "SATISFIED_TRANSITIVELY", "SATISFIED_BY_CLIENT_EQUIVALENT",
        "PARTIALLY_SATISFIED", "MISSING", "DUPLICATED", "CLIENT_FEATURE_DISABLED",
        "NOT_APPLICABLE_WITH_EVIDENCE", "AMBIGUOUS", "REQUIRES_RESEARCH", "REQUIRES_DEVELOPER"
      ]
    },
    "missingEvidence": { "type": ["string", "null"] },
    "plannedAction": { "type": "string" },
    "resolvedInFiles": { "type": "array", "items": { "type": "string" } },
    "uncertaintyIds": { "type": "array", "items": { "type": "string" } },
    "risk": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "validation": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
