    "workspaceType": { "enum": ["NGMODULE", "STANDALONE", "HYBRID", "UNKNOWN"] },
    "bootstrapStyle": { "type": "string" },
    "coverageRef": { "type": "string" },
    "fileInventoryRef": { "type": "string" },
    "semanticGraphRef": { "type": "string" }
  },
  "additionalProperties": true
}
