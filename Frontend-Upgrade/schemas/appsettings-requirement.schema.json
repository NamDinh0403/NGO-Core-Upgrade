{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/appsettings-requirement.schema.json",
  "title": "AppSettings requirement",
  "description": "A backend configuration requirement discovered from release knowledge, mapped to owning process, file section/key, and Azure variable.",
  "type": "object",
  "required": ["schemaVersion", "id", "key", "owningProcess", "timing", "automation", "risk", "confidence", "status"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string" },
    "releaseVersion": { "type": ["string", "null"] },
    "key": { "type": "string" },
    "section": { "type": ["string", "null"] },
    "owningProcess": { "enum": ["API", "WEBJOB", "TOOL", "DEPLOYMENT", "ALL"] },
    "azureKey": { "type": ["string", "null"] },
    "dataType": { "enum": ["string", "int", "bool", "cron", "connectionString", "secret", "list"] },
    "defaultValue": { "type": ["string", "null"] },
    "preserveClientValue": { "type": "boolean" },
    "sensitive": { "type": "boolean" },
    "timing": {
      "enum": ["BEFORE_UPGRADE", "DURING_UPGRADE", "BEFORE_DEPLOYMENT", "AFTER_DEPLOYMENT", "MANUAL_REVIEW"]
    },
    "automation": {
      "enum": ["AUTO_SAFE", "AUTO_AFTER_MAPPING", "MANUAL_DECISION", "MANUAL_EXECUTION", "REPORT_ONLY"]
    },
    "validation": { "type": ["string", "null"] },
    "risk": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
    "status": { "enum": ["ACTIVE", "SUPERSEDED", "DUPLICATE", "DRAFT"] },
    "owner": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
