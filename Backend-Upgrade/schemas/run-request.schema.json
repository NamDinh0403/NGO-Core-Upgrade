{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/run-request.schema.json",
  "title": "Run Request",
  "type": "object",
  "required": ["schemaVersion", "runId", "clientId", "solutionPath", "sourceVersion", "targetVersion", "workflowVersion", "createdAt"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "runId": { "type": "string", "description": "sanitized-client-id + UTC timestamp + sequence" },
    "clientId": { "type": "string", "description": "sanitized, kebab-case, no secrets" },
    "solutionPath": { "type": "string" },
    "sourceVersion": { "type": "string" },
    "targetVersion": { "type": "string" },
    "workflowVersion": { "type": "string" },
    "modelId": { "type": ["string", "null"] },
    "toolVersions": { "type": "object" },
    "requestedBy": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
