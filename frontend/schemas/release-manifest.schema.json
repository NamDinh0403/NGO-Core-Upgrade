{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/release-manifest.schema.json",
  "title": "Per-version release manifest",
  "description": "release.yaml for a single version: metadata + which scope files carry requirements.",
  "type": "object",
  "required": ["schemaVersion", "version", "scopes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "frameworkTransition": {
      "type": "object",
      "properties": {
        "angularFrom": { "type": ["string", "null"] },
        "angularTo": { "type": ["string", "null"] },
        "dotnetFrom": { "type": ["string", "null"] },
        "dotnetTo": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "scopes": {
      "type": "array",
      "items": { "enum": ["frontend", "backend", "database", "deployment", "decisions"] }
    },
    "requirementCount": { "type": "integer" },
    "sourceEvidence": { "type": "string" }
  },
  "additionalProperties": false
}
