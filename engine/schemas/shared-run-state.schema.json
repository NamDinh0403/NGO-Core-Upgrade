{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "orchestrator/schemas/shared-run-state.schema.json",
  "title": "Shared run state",
  "description": "Engine-owned authoritative lifecycle; legacy track state files are evidence/checkpoint projections, not independent upgrade runs.",
  "type": "object",
  "required": ["schemaVersion", "runId", "clientId", "tracks", "status", "startedAt", "updatedAt", "nextAction"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "runId": { "type": "string" },
    "clientId": { "type": "string" },
    "tracks": { "type": "array", "items": { "type": "string", "enum": ["backend", "frontend"] } },
    "sourceVersion": { "type": ["string", "null"] },
    "targetVersion": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["CREATED", "REQUIREMENTS_READY", "DELEGATED", "RESULTS_COMPOSED", "COVERAGE_VERIFIED", "HANDOVER_READY", "COMPLETE", "BLOCKED"]
    },
    "trackStatus": {
      "type": "object",
      "properties": {
        "backend": { "type": ["string", "null"] },
        "frontend": { "type": ["string", "null"] }
      }
    },
    "backendRunRef": { "type": ["string", "null"], "description": "backend/runs/<client>/<run-id>/ path this shared run's backend result was composed from." },
    "frontendRunRef": { "type": ["string", "null"], "description": "frontend/runs/<client>/<run-id>/ path this shared run's frontend result was composed from." },
    "ingestCandidateRef": { "type": ["string", "null"], "description": "ingest/knowledge/candidates/releases/<version>.json this run's requirements were split from." },
    "ingestCandidateRefs": { "type": "array", "items": { "type": "string" } },
    "safeResumeInstruction": { "type": "string" },
    "ingestEvidenceHash": { "type": ["string", "null"] },
    "coreChangeSetRef": { "type": "string" },
    "coreChangeSetFingerprint": { "type": "string" },
    "upgradeContextRef": { "type": "string" },
    "trackContextRefs": { "type": "object", "properties": { "backend": { "type": "string" }, "frontend": { "type": "string" } }, "additionalProperties": false },
    "contextEvidenceHash": { "type": ["string", "null"] },
    "contextRequired": { "type": "boolean" },
    "executionContract": { "const": "ENGINE" },
    "inputEvidenceRefs": { "type": "array", "items": { "type": "string" } },
    "domainEvidenceRefs": { "type": "array", "items": { "type": "string" } },
    "clientDiscoveryRef": { "type": "string" },
    "lifecyclePhase": { "enum": ["DISCOVER", "CORE_ANALYSIS", "IMPACT_ANALYSIS", "PLAN", "EXECUTE", "VALIDATE", "REPORT", "BLOCKED"] },
    "lifecycleHistory": { "type": "array", "items": { "type": "object" } },
    "executorPlans": { "type": "object" },
    "executorEvidence": { "type": "object" },
    "retryAttempts": { "type": "object" },
    "retryIterations": { "type": "object" },
    "retryAuthorizations": { "type": "object" },
    "replanApproval": { "type": "object" },
    "executorStatus": { "type": "object", "additionalProperties": { "enum": ["READY", "RUNNING", "PASSED", "FAILED", "BLOCKED"] } },
    "coverageEvidenceHash": { "type": ["string", "null"] },
    "handoverEvidenceHash": { "type": ["string", "null"] },
    "nextAction": { "type": "string" },
    "startedAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  },
  "additionalProperties": false
}
