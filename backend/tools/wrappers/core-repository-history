#!/usr/bin/env node
'use strict';
/*
 * Core-repository history wrapper: read-only git inspection of the local
 * NGO.Core checkout declared in config/core-repository.yaml (request.coreRepoPath).
 * Used only by skills/ingest-core-release. Never targets or mutates the CLIENT
 * repository, and never mutates the Core repository itself — only read verbs
 * are allowed, plus `worktree add --detach` for isolated ref inspection
 * (mirrors Frontend-Upgrade/tools/lib/git.js#addReadonlyWorktree).
 */
const { runWrapper } = require('./lib/wrapper');

// Mutating/dangerous verbs are refused outright, regardless of target — this
// wrapper must never be usable to change Core (or, by mistake, the client).
const MUTATING_VERBS = [
  'commit', 'push', 'checkout', 'switch', 'reset', 'merge', 'rebase', 'cherry-pick',
  'clean', 'stash', 'rm', 'mv', 'add', 'restore', 'branch', 'submodule', 'filter-branch',
  'gc', 'prune', 'fetch', 'pull', 'clone', 'remote', 'config',
];

// Caller supplies `-C "<coreRepoPath>"` as the first user args (the repo path
// comes from config/core-repository.yaml / request.coreRepoPath, never from
// this wrapper). Disable the filesystem-monitor daemon so a lingering
// `git fsmonitor--daemon` child cannot hold this process's stdout open.
const r = runWrapper({
  toolId: 'git',
  capability: 'inspect-core-repository-history',
  argsPrefix: ['-c', 'core.fsmonitor=false', '-c', 'core.useBuiltinFSMonitor=false'],
  userArgs: process.argv.slice(2),
  mutatingVerbs: MUTATING_VERBS,
  allowClientMutation: false,
});
process.stdout.write(JSON.stringify(r, null, 2) + '\n');
process.exit(r.status === 'SUCCEEDED' ? 0 : 1);
