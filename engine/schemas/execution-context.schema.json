{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "engine/schemas/execution-context.schema.json",
  "title": "Shared Execution Contracts",
  "oneOf": [
    { "$ref": "#/definitions/CoreChangeSet" },
    { "$ref": "#/definitions/UpgradeContext" },
    { "$ref": "#/definitions/TrackContext" }
  ],
  "definitions": {
    "BackendContext": { "allOf": [{ "$ref": "#/definitions/TrackContext" }, { "properties": { "track": { "const": "backend" } } }] },
    "FrontendContext": { "allOf": [{ "$ref": "#/definitions/TrackContext" }, { "properties": { "track": { "const": "frontend" } } }] },
    "CoreChangeSet": {
      "$ref": "../../ingest/schemas/core-change-set.schema.json"
    },
    "UpgradeContext": {
      "type": "object",
      "required": ["schemaVersion", "run", "client", "coreChangeSet", "target", "sharedRequirements", "integration", "policies", "evidence"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 }, "run": { "type": "object" }, "client": { "type": "object" },
        "coreChangeSet": { "type": "object", "required": ["ref", "fingerprint"], "properties": { "ref": { "type": "string" }, "fingerprint": { "type": "string" } }, "additionalProperties": false },
        "target": { "type": "object", "required": ["sourceVersion", "targetVersion"], "properties": { "sourceVersion": { "type": "string" }, "targetVersion": { "type": "string" } }, "additionalProperties": false },
        "sharedRequirements": { "type": "array" }, "integration": { "type": "object" }, "policies": { "type": "object" }, "evidence": { "type": "object" }
      }
    },
    "TrackContext": {
      "type": "object",
      "required": ["schemaVersion", "track", "upgrade", "client", "requirements", "excluded", "policies", "evidence", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 }, "track": { "enum": ["backend", "frontend"] },
        "upgrade": { "$ref": "#/definitions/UpgradeContext" },
        "client": { "type": "object", "required": ["path", "facts"], "properties": { "path": { "type": ["string", "null"] }, "facts": { "type": "object" } }, "additionalProperties": false },
        "requirements": { "type": "array" }, "excluded": { "type": "array" },
        "policies": { "type": "object" }, "evidence": { "type": "object" }, "fingerprint": { "type": "string" }
      }
    }
  }
}