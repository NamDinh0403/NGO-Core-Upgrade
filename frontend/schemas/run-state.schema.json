{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/run-state.schema.json",
  "title": "Authoritative run state snapshot",
  "type": "object",
  "required": ["schemaVersion", "runId", "clientId", "status", "currentPhase", "nextAction", "safeResumeInstruction"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "runId": { "type": "string" },
    "clientId": { "type": "string" },
    "status": { "enum": ["IN_PROGRESS", "BLOCKED", "COMPLETE", "DOCUMENTATION_PENDING", "AUDIT_PENDING"] },
    "currentPhase": { "type": "string" },
    "currentSkill": { "type": ["string", "null"] },
    "completedPhases": { "type": "array", "items": { "type": "string" } },
    "clientPath": { "type": ["string", "null"] },
    "corePath": { "type": ["string", "null"] },
    "sourceVersion": { "type": ["string", "null"] },
    "targetVersion": { "type": ["string", "null"] },
    "coreSourceCommit": { "type": ["string", "null"] },
    "coreTargetCommit": { "type": ["string", "null"] },
    "doctorStatus": { "type": ["string", "null"] },
    "planStatus": { "type": ["string", "null"] },
    "auditStatus": { "type": ["string", "null"] },
    "packageAlignmentStatus": { "type": ["string", "null"] },
    "semanticCoverage": { "type": ["string", "null"] },
    "requirementMappingStatus": { "type": ["string", "null"] },
    "assumptions": { "type": "array" },
    "blockingUncertainty": { "type": "array" },
    "changedFiles": { "type": "array" },
    "buildStatus": { "type": ["string", "null"] },
    "testStatus": { "type": ["string", "null"] },
    "documentationStatus": { "type": "object" },
    "implementationComplete": { "type": "boolean" },
    "auditPassed": { "type": "boolean" },
    "lastCheckpoint": { "type": ["string", "null"] },
    "lastAction": { "type": ["string", "null"] },
    "nextAction": { "type": "string" },
    "safeResumeInstruction": { "type": "string" },
    "idempotency": { "type": "object" },
    "startedAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  },
  "additionalProperties": true
}
