# Generated run output - never commit per config/repository-layout-policy.yaml.
# Keep the runs/ directory (placeholder README + .gitkeep) but ignore actual runs.
# Run directories contain client-identifying data, build logs and probe/obj
# artifacts; they are local execution state, not repository content.
/runs/*
!/runs/README.md
!/runs/.gitkeep

# Node / tooling
node_modules/
npm-debug.log*
*.tmp
*.out

# Isolated research tooling installed per run (config/tool-installation-policy.yaml ->
# npmTools.isolatedToolingDir). Versions are resolved from the client repository at
# bootstrap time, so committed manifests here would pin the wrong toolchain.
/tools/frontend-runtime/

# Extracted Core sources / temporary package archives / tool caches / logs
**/research/core-target/
*.tgz
*.log
