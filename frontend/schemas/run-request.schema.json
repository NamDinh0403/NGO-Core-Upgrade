{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/run-request.schema.json",
  "title": "Frontend upgrade run request",
  "type": "object",
  "required": ["schemaVersion", "repositories", "upgrade"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "request": {
      "type": "object",
      "properties": { "clientId": { "type": ["string", "null"] } }
    },
    "repositories": {
      "type": "object",
      "required": ["client", "core"],
      "properties": {
        "client": {
          "type": "object",
          "required": ["path"],
          "properties": {
            "path": { "type": "string" },
            "expectedPackageName": { "type": "string" },
            "mutable": { "type": "boolean", "const": true }
          }
        },
        "core": {
          "type": "object",
          "required": ["path"],
          "properties": {
            "path": { "type": "string" },
            "targetRef": { "type": ["string", "null"] },
            "readOnly": { "type": "boolean", "const": true }
          }
        }
      }
    },
    "upgrade": {
      "type": "object",
      "required": ["sourceVersion"],
      "properties": {
        "sourceVersion": { "type": "string" },
        "targetVersion": { "type": ["string", "null"] }
      }
    },
    "execution": { "type": "object" },
    "validation": { "type": "object" }
  },
  "additionalProperties": true
}
