{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skills/research-version/schemas/input.schema.json",
  "title": "research-version input",
  "type": "object",
  "required": ["skillId", "runDir", "targetVersion", "uncertaintyIds"],
  "properties": {
    "skillId": { "type": "string", "const": "research-version" },
    "runDir": { "type": "string" },
    "sourceVersion": { "type": ["string", "null"] },
    "targetVersion": { "type": "string" },
    "packages": { "type": "array", "items": { "type": "string" } },
    "uncertaintyIds": { "type": "array", "items": { "type": "string" } },
    "isolatedStorage": { "type": "string" }
  },
  "additionalProperties": true
}
