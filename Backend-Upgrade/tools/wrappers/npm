#!/usr/bin/env node
'use strict';
/* npm research wrapper (view/pack/diff). Refuses install/ci in a client repo. */
const { runWrapper } = require('./lib/wrapper');
const r = runWrapper({
  toolId: 'npm', capability: 'acquire-npm-package', argsPrefix: [],
  userArgs: process.argv.slice(2), mutatingVerbs: ['install', 'ci', 'add', 'update'],
});
r.nextRecommendedAction = r.status === 'SUCCEEDED' ? 'extract-package' : 'inspect-logs';
process.stdout.write(JSON.stringify(r, null, 2) + '\n');
process.exit(r.status === 'SUCCEEDED' ? 0 : 1);
