{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skills/inventory-client-frontend/schemas/output.schema.json",
  "type": "object",
  "required": ["skillId", "status", "workspaceType", "bootstrapStyle", "coverageRef", "fileInventoryRef", "semanticGraphRef"],
  "properties": {
    "skillId": { "type": "string", "const": "inventory-client-frontend" },
