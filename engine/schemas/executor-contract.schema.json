{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "engine/schemas/executor-contract.schema.json",
  "title": "Shared Plan Evidence And Result Contracts",
  "definitions": {
    "Plan": {
      "type": "object", "required": ["status", "changes"],
      "properties": {
        "status": { "enum": ["DRAFT", "READY", "READY_WITH_ASSUMPTIONS", "RESEARCH_REQUIRED", "BLOCKED_NEEDS_CONTEXT", "BLOCKED_NEEDS_DEVELOPER", "FAILED_POLICY"] },
        "changes": {
          "type": "array", "items": { "type": "object", "required": ["file", "evidence", "validation"],
            "properties": { "file": { "type": "string", "minLength": 1 }, "evidence": { "type": "string", "minLength": 1 }, "validation": { "type": "string", "minLength": 1 } } }
        }
      }
    },
    "Evidence": {
      "type": "array", "items": { "type": "object", "required": ["kind", "status", "ref"], "additionalProperties": false,
        "properties": { "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }, "status": { "enum": ["PASSED", "FAILED", "BLOCKED", "SKIPPED"] }, "ref": { "type": "string", "minLength": 1 } } }
    },
    "ValidationResult": {
      "type": "object", "required": ["passed", "missing", "nextAction"],
      "properties": { "passed": { "type": "boolean" }, "missing": { "type": "array", "items": { "type": "string" } }, "nextAction": { "type": "string", "minLength": 1 } }
    },
    "TrackResult": {
      "type": "object", "required": ["track", "status", "evidence"],
      "properties": { "track": { "enum": ["backend", "frontend"] }, "status": { "enum": ["READY", "RUNNING", "PASSED", "FAILED", "BLOCKED"] }, "evidence": { "type": "array" } }
    }
  }
}