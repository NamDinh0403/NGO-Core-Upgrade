    "9.0.0": {
      "releaseDate": "2026-06-01",
      "targetFramework": "net10.0",
      "breakingChanges": [
        {
          "type": "framework",
          "change": "Upgraded to .NET 10. Update all projects to target net10.0 BEFORE upgrading Core packages; update build-pipeline-api.yml netVersion 8.0 -> 10.0; update Azure App Service runtime to .NET 10.",
          "impact": "high",
          "autoFix": true
        },
        {
          "type": "data-model",
          "change": "Workflow instances moved from JSON config to relational tables (CorePhaseInstances, CorePhaseTemplateInstances). After deployment the ConvertWorkflowInstanceJsonConfigToTables tool must be run or the Workflow Cycle tab will not render.",
          "impact": "high",
          "autoFix": false
        },
        {
          "type": "configuration",
          "change": "Draft/Published workflow requires a new queue key SyncPublishedWorkflowQueue = syncpublishedworkflowqueue in every appSettings.json, and Azure App Setting Core:Queue:SyncPublishedWorkflowQueue.",
          "impact": "medium",
          "autoFix": true
        }
      ],
      "newDependencies": [],
      "requiredSettings": {
        "queue": [
          { "key": "SyncPublishedWorkflowQueue", "default": "syncpublishedworkflowqueue" }
        ],
        "core": []
      },
      "deploymentTools": [
        { "tool": "ConvertWorkflowInstanceJsonConfigToTables", "when": "after-deployment", "required": true }
      ],
      "diffFiles": []
    },
    "9.1.0": {
      "releaseDate": "2026-07-01",
      "targetFramework": "net10.0",
      "breakingChanges": [
        {
          "type": "data-model",
          "class": "Log / Log2 / Log3",
          "change": "New RelatedEntity fields added. If a client needs the field to hold multiple values, change the field type to instances in code.",
          "impact": "low",
          "autoFix": false
        },
        {
          "type": "configuration",
          "change": "New system config SPSignedOffAdditionalDocumentsFolderName (default 'Additional documents') controls the optional approval subfolder for Mark as Paid / Cancel actions. Confirm value with client PM/AM. After deployment, if the client uses Mark as Paid or Cancel on payments, update appsettings.json and run NGO.Core.Tools.UpdatePaymentDocumentLinks.",
          "impact": "medium",
          "autoFix": false
        }
      ],
      "newDependencies": [
        "Microsoft.EntityFrameworkCore.Design@10.0.7 (NGO.API)",
        "Microsoft.EntityFrameworkCore.Tools@10.0.7 (NGO.API)"
      ],
      "requiredSettings": {
        "queue": [],
        "core": [
          { "key": "SPSignedOffAdditionalDocumentsFolderName", "default": "Additional documents" }
        ]
      },
      "deploymentTools": [
        { "tool": "NGO.Core.Tools.UpdatePaymentDocumentLinks", "when": "after-deployment", "required": false, "condition": "client uses Mark as Paid or Cancel on payments" }
      ],
