{
  // NGO Core Upgrade — multi-root workspace template.
  //
  // HOW TO USE:
  // 1. Copy this file next to (or anywhere near) your client solution and rename it,
  //    e.g. "Acme-NGO-Upgrade.code-workspace".
  // 2. Edit the SECOND folder path below to point at the client project you want to
  //    upgrade (absolute path, forward slashes work on Windows too).
  // 3. Double-click the file (or File > Open Workspace from File...) to open BOTH the
  //    agent and the client in one VS Code window.
  // 4. Open Copilot Chat > agent mode > pick "NGO Core Upgrade Orchestrator" (or a
  //    single-track agent), or just type your upgrade request.
  //
  // The agent's skills/workflow/CLIs live in THIS folder; the client repo stays clean.
  "folders": [
    {
      "name": "NGO Core Upgrade Agent",
      "path": "."
    },
    {
      "name": "Client Solution (EDIT ME)",
      "path": "../PATH/TO/YOUR/CLIENT/SOLUTION"
    }
  ],
  "settings": {
    // Discover the agent's .github/skills and .github/agents from every workspace root.
    "chat.useCustomizationsInParentRepositories": true
  }
}
