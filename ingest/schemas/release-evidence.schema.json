{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ingest/schemas/release-evidence.schema.json",
  "title": "Release Immutable Evidence (Schema v2)",
  "description": "Immutable source evidence for a release, containing git commit ranges, diff summaries, and provenance.",
  "type": "object",
  "required": ["schemaVersion", "version", "provenance", "gitDiff"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "provenance": {
      "type": "object",
      "required": ["coreRepoPath", "commitRange", "analyzerVersion", "ingestedAt"],
      "properties": {
        "coreRepoPath": { "type": "string" },
        "commitRange": {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": { "type": ["string", "null"] },
            "to": { "type": "string" }
          }
        },
        "tagRange": {
          "type": "object",
          "properties": {
            "from": { "type": ["string", "null"] },
            "to": { "type": "string" }
          }
        },
        "sourceBranch": { "type": ["string", "null"] },
        "releaseNotesHash": { "type": ["string", "null"] },
        "analyzerVersion": { "type": "string" },
        "ingestedAt": { "type": "string" }
      }
    },
    "gitDiff": {
      "type": "object",
      "required": ["totalFilesChanged", "rawChanges"],
      "properties": {
        "totalFilesChanged": { "type": "integer" },
        "rawChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["status", "path"],
            "properties": {
              "status": { "type": "string" },
              "path": { "type": "string" },
              "oldPath": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
